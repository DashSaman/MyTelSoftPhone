<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/shape_dialog_background">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_500"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/start_chat_title"
            android:textSize="18sp"
            android:textColor="?attr/color_main2_800" />

        <androidx.appcompat.widget.AppCompatEditText
            style="@style/default_text_style"
            android:id="@+id/number_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:gravity="center"
            android:inputType="phone"
            android:maxLines="1"
            android:hint="@string/start_chat_hint"
            android:textSize="24sp"
            android:background="@drawable/mytel_edit_text_background" />

        <GridLayout
            android:id="@+id/numpad_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="4">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_1" android:text="1" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_2" android:text="2" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_3" android:text="3" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_4" android:text="4" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_5" android:text="5" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_6" android:text="6" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_7" android:text="7" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_8" android:text="8" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_9" android:text="9" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_star" android:text="*" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_0" android:text="0" />
            <androidx.appcompat.widget.AppCompatTextView
                style="@style/start_chat_key_style" android:id="@+id/key_hash" android:text="#" />
        </GridLayout>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_300"
            android:id="@+id/key_backspace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="@string/start_chat_backspace"
            android:textSize="16sp"
            android:background="@drawable/squircle_transparent_button_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/default_text_style_500"
                android:id="@+id/call_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/start_chat_call_action"
                android:textSize="14sp"
                android:textColor="?attr/color_main1_500"
                android:background="@drawable/squircle_transparent_button_background" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/default_text_style_500"
                android:id="@+id/chat_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/start_chat_action"
                android:textSize="14sp"
                android:textColor="?attr/color_on_main"
                android:background="@drawable/mytel_primary_button_background" />
        </LinearLayout>
    </LinearLayout>
</layout>
